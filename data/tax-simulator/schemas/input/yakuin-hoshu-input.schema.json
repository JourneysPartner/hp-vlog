        "totalIncome": {
          "$ref": "#/$defs/MoneyWire"
        }
      },
      "required": [
        "id",
        "relation"
      ],
      "additionalProperties": false
    },
    "DependentRelationWire": {
      "enum": [
        "child",
        "parent",
        "grandparent",
        "sibling",
        "other_relative"
      ]
    },
    "IncomeItemWire": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/IncomeCategoryWire"
        },
        "taxationMethod": {
          "$ref": "#/$defs/TaxationMethodWire"
        },
        "amount": {
          "$ref": "#/$defs/MoneyWire"
        },
        "label": {
