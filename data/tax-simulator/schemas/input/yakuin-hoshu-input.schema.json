        "officer",
        "specialistChecks"
      ],
      "additionalProperties": false
    },
    "TriStateWire": {
      "enum": [
        "yes",
        "no",
        "unknown"
      ]
    },
    "MoneyWire": {
      "type": "object",
      "properties": {
        "unit": {
          "const": "JPY"
        },
        "value": {
          "type": "string",
          "pattern": "^-?[0-9]+$",
          "description": "整数を表すDecimal。指数表記と桁区切りは不可。"
        }
      },
      "required": [
        "unit",
        "value"
      ],
      "additionalProperties": false
    },
    "HealthInsurerInputWire": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "kyokai_kenpo"
            },
            "prefectureCode": {
              "$ref": "#/$defs/PrefectureCodeWire"
            }
          },
          "required": [
            "kind",
            "prefectureCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "kenpo_kumiai"
            },
            "insurerCode": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "insurerCode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "none"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "unknown"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PrefectureCodeWire": {
      "type": "string",
      "pattern": "^[0-9]{2}$",
      "description": "JIS X 0401の都道府県コード2桁。"
    },
    "PersonFactsWire": {
      "type": "object",
      "properties": {
        "ageAtYearEnd": {
          "type": "integer"
        },
        "disability": {
          "$ref": "#/$defs/DisabilityCategoryWire"
        },
        "isNonResident": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
