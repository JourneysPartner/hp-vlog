            "taxCredits": {
              "type": "object",
              "properties": {
                "housingLoan": {
                  "$ref": "#/$defs/MoneyWire"
                },
                "other": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "amount": {
                        "$ref": "#/$defs/MoneyWire"
                      }
                    },
                    "required": [
                      "code",
                      "amount"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            },
            "appointedOn": {
              "$ref": "#/$defs/LocalDateWire"
            },
            "previousMonthlyAmount": {
              "$ref": "#/$defs/MoneyWire"
            },
            "standardRemunerationDecisionKind": {
              "enum": [
                "on_qualification",
                "regular",
                "occasional"
