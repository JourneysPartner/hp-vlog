            },
            "specialistChecks": {
              "$ref": "#/$defs/SpecialistChecksWire"
            },
            "employeeCount": {
              "type": "integer"
            },
            "spouse": {
              "$ref": "#/$defs/SpouseFactsWire"
            },
            "dependents": {
              "type": "array",
              "items": {
