              }
            },
            "deductions": {
              "$ref": "#/$defs/PersonalDeductionFactsWire"
            },
            "taxCredits": {
              "type": "object",
              "properties": {
                "housingLoan": {
                  "$ref": "#/$defs/MoneyWire"
                },
                "other": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "code": {
                        "type": "string"
                      },
                      "amount": {
                        "$ref": "#/$defs/MoneyWire"
                      }
                    },
                    "required": [
